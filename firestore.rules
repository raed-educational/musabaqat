rules_version = '2';
// Reference copy of the rules published for project musabaqat-f24e4 (Firestore > Rules).
// Public read; each anonymous user may write only leaderboard/{their uid}, with sane values and small, spaced increments.
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      function valid(d) {
        return d.keys().hasOnly(['name','avatar','points','games','correct','answered','wins','cats','updatedAt'])
          && d.keys().hasAll(['name','avatar','points','games','correct','answered','wins','cats','updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
          && d.avatar is string && d.avatar.size() <= 16
          && d.games is int && d.games >= 0
          && d.points is int && d.points >= 0 && d.points <= d.games * 5000
          && d.answered is int && d.answered >= 0
          && d.correct is int && d.correct >= 0 && d.correct <= d.answered
          && d.wins is int && d.wins >= 0 && d.wins <= d.games
          && d.cats is map && d.cats.size() <= 13
          && d.updatedAt == request.time;
      }
      allow create: if request.auth != null && request.auth.uid == uid
        && valid(request.resource.data) && request.resource.data.games <= 3;
      allow update: if request.auth != null && request.auth.uid == uid
        && valid(request.resource.data)
        && request.resource.data.games >= resource.data.games
        && request.resource.data.games <= resource.data.games + 3
        && request.resource.data.points <= resource.data.points + 15000
        && request.time > resource.data.updatedAt + duration.value(15, 's');
    }
  }
}
